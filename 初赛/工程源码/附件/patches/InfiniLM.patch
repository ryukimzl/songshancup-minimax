diff --git a/csrc/models/qwen3_vl/condition_trace.hpp b/csrc/models/qwen3_vl/condition_trace.hpp
new file mode 100644
index 0000000..3d170c6
--- /dev/null
+++ b/csrc/models/qwen3_vl/condition_trace.hpp
@@ -0,0 +1,126 @@
+#pragma once
+
+#include "../../global_state/global_state.hpp"
+#include <infinicore/context/context.hpp>
+#include <infinicore/tensor.hpp>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+// Host-side diagnostics only. Disabled by default; never changes model values.
+namespace infinilm::models::condition_trace {
+struct Snapshot {
+    int dtype;
+    std::string shape;
+    std::vector<unsigned char> bytes;
+};
+struct State {
+    bool active = false;
+    int run = 0, rank = -1;
+    size_t compared = 0, differences = 0;
+    bool io_error = false;
+    std::string directory, prefix, first;
+    FILE *file = nullptr;
+    std::unordered_map<std::string, size_t> counts;
+    std::unordered_map<std::string, Snapshot> baseline;
+};
+inline State &state() { static thread_local State value; return value; }
+inline bool requested() {
+    const char *flag = std::getenv("H3_CONDITION_TRACE");
+    return flag && std::strcmp(flag, "1") == 0;
+}
+inline void begin() {
+    auto &s = state();
+    s.active = requested();
+    if (!s.active) { return; }
+    const char *run = std::getenv("H3_CONDITION_TRACE_RUN");
+    const char *directory = std::getenv("H3_CONDITION_TRACE_DIR");
+    s.run = run ? std::atoi(run) : 0;
+    s.rank = global_state::get_tensor_model_parallel_rank_info().tp_rank;
+    s.active = directory && (s.run == 1 || s.run == 2);
+    if (!s.active) {
+        std::fprintf(stderr, "COND_TRACE_CONFIG_FAIL rank=%d\n", s.rank);
+        return;
+    }
+    s.directory = directory;
+    s.prefix.clear(); s.first.clear(); s.counts.clear();
+    s.compared = 0; s.differences = 0; s.io_error = false;
+    if (s.run == 1) { s.baseline.clear(); }
+    auto path = s.directory + "/rank-" + std::to_string(s.rank) + ".tsv";
+    s.file = std::fopen(path.c_str(), s.run == 1 ? "w" : "a");
+    if (!s.file) { s.io_error = true; }
+}
+struct Scope {
+    std::string previous;
+    bool active;
+    explicit Scope(const std::string &name) : active(state().active) {
+        if (active) { previous = state().prefix; state().prefix += name; }
+    }
+    ~Scope() { if (active) { state().prefix = previous; } }
+};
+inline bool save_bytes(const std::string &path, const std::vector<unsigned char> &bytes) {
+    auto *file = std::fopen(path.c_str(), "wb");
+    if (!file) { return false; }
+    const bool ok = std::fwrite(bytes.data(), 1, bytes.size(), file) == bytes.size();
+    return std::fclose(file) == 0 && ok;
+}
+inline void record(const std::string &name, const infinicore::Tensor &tensor) {
+    auto &s = state();
+    if (!s.active) { return; }
+    if (!tensor) { return; }
+    auto packed = tensor->contiguous();
+    infinicore::context::syncStream();
+    auto cpu = packed->to(infinicore::Device::cpu());
+    // D2H is synchronous in the current runtime; the producer wait above is explicit.
+    Snapshot current;
+    current.dtype = static_cast<int>(cpu->dtype());
+    for (auto dim : cpu->shape()) { current.shape += std::to_string(dim) + ","; }
+    const auto *data = reinterpret_cast<const unsigned char *>(cpu->data());
+    if (cpu->nbytes()) { current.bytes.assign(data, data + cpu->nbytes()); }
+    const auto base = s.prefix + name;
+    const auto key = base + "@" + std::to_string(++s.counts[base]);
+    bool equal = true;
+    if (s.run == 1) {
+        s.baseline[key] = current;
+    } else {
+        ++s.compared;
+        auto found = s.baseline.find(key);
+        equal = found != s.baseline.end() && found->second.dtype == current.dtype
+                && found->second.shape == current.shape && found->second.bytes == current.bytes;
+        if (!equal) {
+            ++s.differences;
+            if (s.first.empty()) {
+                s.first = key;
+                std::fprintf(stderr, "COND_TRACE_FIRST_DIFF rank=%d stage=%s dtype=%d shape=%s bytes=%zu\n",
+                             s.rank, key.c_str(), current.dtype, current.shape.c_str(), current.bytes.size());
+                // Bound saved evidence; no model output is substituted with snapshots.
+                if (found != s.baseline.end() && found->second.bytes.size() <= 16*1024*1024
+                    && current.bytes.size() <= 16*1024*1024) {
+                    const auto prefix = s.directory + "/rank-" + std::to_string(s.rank);
+                    s.io_error |= !save_bytes(prefix + "-first-run1.bin", found->second.bytes);
+                    s.io_error |= !save_bytes(prefix + "-first-run2.bin", current.bytes);
+                }
+            }
+        }
+        if (found != s.baseline.end()) { s.baseline.erase(found); }
+    }
+    if (s.file && std::fprintf(s.file, "%d\t%d\t%s\t%d\t%d\t%s\t%zu\n", s.run, s.rank,
+                              key.c_str(), equal ? 1 : 0, current.dtype,
+                              current.shape.c_str(), current.bytes.size()) < 0) { s.io_error = true; }
+}
+inline void finish() {
+    auto &s = state();
+    if (!s.active) { return; }
+    const size_t remaining = s.baseline.size();
+    if (s.file) { s.io_error |= std::fclose(s.file) != 0; s.file = nullptr; }
+    std::fprintf(stderr, "COND_TRACE_SUMMARY run=%d rank=%d compared=%zu differences=%zu remaining=%zu io_error=%d first=%s\n",
+                 s.run, s.rank, s.compared, s.differences, remaining, int(s.io_error),
+                 s.first.empty() ? "none" : s.first.c_str());
+    if (s.run == 2) { s.baseline.clear(); }
+    s.active = false;
+}
+} // namespace infinilm::models::condition_trace
