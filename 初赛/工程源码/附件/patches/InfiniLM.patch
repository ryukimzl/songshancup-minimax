+inline StageProfile &stage_profile() {
+    static thread_local StageProfile profile;
+    return profile;
+}
+
+inline bool profiling_on() {
+    return stage_profile_enabled() && !stage_profile().done;
+}
+
+class StageTimer {
+public:
+    explicit StageTimer(double &slot) : slot_(slot), enabled_(profiling_on()) {
+        if (!enabled_) {
+            return;
+        }
+        infinicore::context::syncStream();
+        started_ = std::chrono::steady_clock::now();
+    }
+    ~StageTimer() {
+        if (!enabled_) {
+            return;
+        }
+        infinicore::context::syncStream();
+        slot_ += std::chrono::duration<double>(
+                     std::chrono::steady_clock::now() - started_)
+                     .count();
+    }
+    StageTimer(const StageTimer &) = delete;
+    StageTimer &operator=(const StageTimer &) = delete;
+
+private:
+    double &slot_;
+    bool enabled_;
+    std::chrono::steady_clock::time_point started_{};
+};
