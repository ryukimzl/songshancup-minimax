+    fp32_prefixes = tuple(model._keep_in_fp32_modules)
+    with (transformer_dir / "model.safetensors.index.json").open(
+        "r", encoding="utf-8"
+    ) as handle:
+        weight_map = json.load(handle)["weight_map"]
