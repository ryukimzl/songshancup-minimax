+def make_max_memory(devices: Sequence[int], fraction: float) -> dict[int, str]:
+    return {
+        device: f"{int(torch.cuda.get_device_properties(device).total_memory / 1024**3 * fraction)}GiB"
+        for device in devices
+    }
