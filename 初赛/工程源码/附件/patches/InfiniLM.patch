+        std::fprintf(stderr, "[h3-stage]   mha      %9.2f s %5.1f%%\n", mha, pct(mha));
+        std::fprintf(stderr, "[h3-stage]   o_proj   %9.2f s %5.1f%%\n", o_proj, pct(o_proj));
+        std::fprintf(stderr, "[h3-stage]   mlp      %9.2f s %5.1f%%\n", mlp, pct(mlp));
+        std::fprintf(stderr, "[h3-stage]   other    %9.2f s %5.1f%%\n", other, pct(other));
+        std::fflush(stderr);
+    }
+};
