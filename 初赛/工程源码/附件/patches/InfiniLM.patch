+            return;
+        }
+        const double measured = qkv + qk_norm + mrope + mha + o_proj + mlp;
+        const double other = block > measured ? block - measured : 0.0;
+        if (block <= 0) {
+            return;
+        }
+        auto pct = [this](double v) { return 100.0 * v / block; };
+        std::fprintf(stderr, "[h3-stage] seq=%zu timed_blocks=%ld block_total=%.2f s\n",
+                     seq, blocks, block);
+        std::fprintf(stderr, "[h3-stage]   qkv_proj %9.2f s %5.1f%%\n", qkv, pct(qkv));
+        std::fprintf(stderr, "[h3-stage]   qk_norm  %9.2f s %5.1f%%\n", qk_norm, pct(qk_norm));
