index 0000000..ca2046e
--- /dev/null
+++ b/test/models/minimax_h3/test_stream_handoff.py
@@ -0,0 +1,187 @@
+"""CPU-only regression for the actual bridge methods using two deferred queues.
+
+Run directly with Python; --baseline loads the immutable src2 archive and is
+expected to fail. This verifies ordering/lifetimes, not GPU numerical accuracy.
+"""
+import ast
+import dataclasses
+import pathlib
+import sys
+import tarfile
+import types
+import unittest
+
+PROJECT = pathlib.Path(__file__).resolve().parents[5]
+SOURCE = PROJECT / '02_源码/InfiniLM/python/infinilm/multimodal/minimax_h3.py'
+BASELINE = '--baseline' in sys.argv
+if BASELINE:
+    sys.argv.remove('--baseline')
+    with tarfile.open(PROJECT / '03_上传包/src2.tar.gz') as archive:
+        SOURCE_TEXT = archive.extractfile(
+            'src/InfiniLM/python/infinilm/multimodal/minimax_h3.py'
+        ).read().decode()
+else:
+    SOURCE_TEXT = SOURCE.read_text()
+
+
+@dataclasses.dataclass(frozen=True)
+class Device:
+    type: str = 'cuda'
+    index: int = 0
+
+
+class Queues:
+    def __init__(self):
+        self.torch = {0: [], 1: []}
+        self.native = {0: [], 1: []}
+
+    def synchronize(self, device):
+        index = device if isinstance(device, int) else device.index
+        for queue in (self.torch[index], self.native[index]):
+            while queue:
+                queue.pop(0)()
+
+
+class Tensor:
+    def __init__(self, queues, value=5, shape=(1,), device=Device(), contiguous=True):
+        self.queues, self.value, self.shape = queues, value, shape
+        self.device, self.is_cuda = device, device.type == 'cuda'
+        self.ndim, self.dtype = len(shape), 'int64'
+        self._contiguous = contiguous
+
+    def is_floating_point(self):
+        return False
+
+    def contiguous(self):
+        if self._contiguous:
+            return self
+        result = Tensor(self.queues, None, self.shape, self.device)
+        self.queues.torch[self.device.index].append(
+            lambda: setattr(result, 'value', self.value)
+        )
+        return result
+
+
+class Native:
+    def __init__(self, owner):
+        self.owner, self.shape, self.dtype = owner, owner.shape, owner.dtype
+
+    def copy_(self, source):
+        self.owner.queues.native[self.owner.device.index].append(
+            lambda: setattr(self.owner, 'value', source.owner.value)
+        )
+
+
+def load_bridge(queues):
+    def deferred(value, shape=(1,), device=Device()):
+        result = Tensor(queues, None, shape, device)
+        queues.torch[device.index].append(lambda: setattr(result, 'value', value))
+        return result
+
+    def empty(shape, dtype, device):
+        # Model a recycled allocation with a previous PyTorch-stream use. An
+        # external-stream write must wait for it, even though empty writes nothing.
+        result = Tensor(queues, None, shape, device)
+        queues.torch[device.index].append(lambda: setattr(result, 'value', -999))
+        return result
+
+    torch = types.SimpleNamespace(
+        nn=types.SimpleNamespace(Module=object), int32='int32', int64='int64', bfloat16='bf16',
+        cuda=types.SimpleNamespace(synchronize=queues.synchronize), empty=empty,
+        arange=lambda n, dtype, device: deferred(7, (n,), device),
+    )
+    native = types.SimpleNamespace(
+        from_torch=Native, utils=types.SimpleNamespace(to_torch_dtype=lambda dtype: dtype),
+        # Old sync_device only waits for native work; it cannot order a preceding
+        # use of the destination on PyTorch's separate stream.
+        sync_device=lambda: [queues.native[0].pop(0)() for _ in range(len(queues.native[0]))],
+    )
+    module = types.ModuleType('_h3_stream_test')
+    sys.modules[module.__name__] = module
+    module.__dict__.update(
+        torch=torch, infinicore=native, dataclass=dataclasses.dataclass,
+        fields=dataclasses.fields, Qwen3VLForConditionalGeneration=object,
+    )
+    tree = ast.parse(SOURCE_TEXT)
+    selected = [n for n in tree.body if isinstance(n, ast.ClassDef) and n.name in {
+        'MiniMaxH3TransformerInputs', 'MiniMaxH3TransformerOutput',
+        'MiniMaxH3ConditionEncoder', 'MiniMaxH3TransformerRunner',
+    }]
+    tree = ast.Module(body=[ast.ImportFrom(module='__future__', names=[
+        ast.alias(name='annotations')], level=0), *selected], type_ignores=[])
+    exec(compile(ast.fix_missing_locations(tree), str(SOURCE), 'exec'), module.__dict__)
+    module.minimax_h3_rotary_cache = lambda positions, **kw: deferred(7, (3, 96), positions.device)
+    return module, deferred
+
+
+class HandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.queues = Queues()
+        self.module, self.deferred = load_bridge(self.queues)
+
+    def engine(self, inspect):
+        return types.SimpleNamespace(
+            distributed_config=types.SimpleNamespace(tp_device_ids=[0, 1]),
+            dtype='bf16', hf_config={}, forward_raw=inspect,
+        )
+
+    def test_condition_encoder_waits_for_producer(self):
+        native_input = Native(self.deferred(5))
+        encoder = object.__new__(self.module.MiniMaxH3ConditionEncoder)
+        encoder.torch_device = Device()
+        encoder._prepare_native_inputs = lambda _: {'input_ids': native_input}
+
+        def forward(input_ids, **kwargs):
+            self.assertEqual(input_ids.owner.value, 5, 'native read raced PyTorch producer')
+            return {'logits': Native(Tensor(self.queues, 11))}
+
+        encoder.engine = self.engine(forward)
+        self.assertEqual(encoder.encode({}).value, 11)
+
+    def test_transformer_waits_for_rope_and_contiguous_copy(self):
+        runner = object.__new__(self.module.MiniMaxH3TransformerRunner)
+        runner.rope_freq_dim, runner.rope_theta = 16, 10000
+        inputs = self.module.MiniMaxH3TransformerInputs(**{
+            field.name: Tensor(self.queues, shape=(3, 3) if field.name == 'position_ids'
+                else (3,) if field.name in ('token_tags', 'timestep_indices')
+                else (1, 1, 2) if field.name.endswith('hidden_states') else (1,),
+                contiguous=field.name != 'video_hidden_states')
+            for field in dataclasses.fields(self.module.MiniMaxH3TransformerInputs)
+        })
+
+        def forward(_, **kwargs):
+            self.assertEqual(kwargs['video_hidden_states'].owner.value, 5,
+                             'contiguous copy was not ready')
+            self.assertEqual(kwargs['rotary_cos_sin_cache'].owner.value, 7,
+                             'rotary cache was not ready')
+            self.assertEqual(kwargs['position_ids'].owner.value, 7)
+            return {'logits': Native(Tensor(self.queues, 11)),
+                    'hidden_states': Native(Tensor(self.queues, 13))}
+
+        runner.engine = self.engine(forward)
+        result = runner(inputs, return_torch=False)
+        self.assertEqual(result.sample.owner.value, 11)
+
+    def test_output_waits_for_recycled_destination(self):
+        result = self.module.MiniMaxH3TransformerRunner._to_torch(
+            Native(Tensor(self.queues, 17)), Device())
+        self.queues.synchronize(Device())
+        self.assertEqual(result.value, 17, 'previous PyTorch use overwrote native output')
+
+    def test_peer_reads_complete_before_return(self):
+        encoder = object.__new__(self.module.MiniMaxH3ConditionEncoder)
+        encoder.torch_device = Device()
+        encoder._prepare_native_inputs = lambda _: {'input_ids': Native(Tensor(self.queues))}
+        peer_done = []
+
+        def forward(*args, **kwargs):
+            self.queues.native[1].append(lambda: peer_done.append(True))
+            return {'logits': Native(Tensor(self.queues, 11))}
+
+        encoder.engine = self.engine(forward)
+        encoder.encode({})
+        self.assertEqual(peer_done, [True], 'peer still uses borrowed inputs after return')
+
+
+if __name__ == '__main__':
+    unittest.main()
