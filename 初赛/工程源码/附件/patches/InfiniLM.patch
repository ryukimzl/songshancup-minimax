diff --git a/test/models/minimax_h3/test_adaln_rounding.py b/test/models/minimax_h3/test_adaln_rounding.py
new file mode 100644
index 0000000..ba96417
--- /dev/null
+++ b/test/models/minimax_h3/test_adaln_rounding.py
@@ -0,0 +1,132 @@
+"""Compile the actual AdaLN helper against CPU BF16 primitive stand-ins.
+
+The native backend is not available locally. This checks the C++ composition,
+rounding boundaries and scalar broadcasting, not the GPU primitives themselves.
+--baseline reads immutable src2 code and is expected to report mismatches.
+"""
+import pathlib
+import subprocess
+import sys
+import tarfile
+import tempfile
+
+PROJECT = pathlib.Path(__file__).resolve().parents[5]
+REL = 'InfiniLM/csrc/models/minimax_h3/minimax_h3_transformer.cpp'
+if '--baseline' in sys.argv:
+    with tarfile.open(PROJECT / '03_上传包/src2.tar.gz') as archive:
+        source = archive.extractfile('src/' + REL).read().decode()
+else:
+    source = (PROJECT / '02_源码' / REL).read_text()
+start = source.index('infinicore::Tensor apply_adaln(')
+brace = source.index('{', start)
+depth, end = 1, brace + 1
+while depth:
+    depth += (source[end] == '{') - (source[end] == '}')
+    end += 1
+helper = source[start:end]
+
+harness = r'''
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <random>
+#include <vector>
+#include <stdexcept>
+namespace infinicore {
+using Strides = std::vector<ptrdiff_t>;
+enum class DataType { BF16, F32 };
+struct Device {};
+float round_bf16(float x) {
+    uint32_t b; std::memcpy(&b, &x, sizeof b);
+    b += 0x7fff + ((b >> 16) & 1); b &= 0xffff0000u;
+    std::memcpy(&x, &b, sizeof x); return x;
+}
+float quantize(float x, DataType dtype) {
+    return dtype == DataType::BF16 ? round_bf16(x) : x;
+}
+struct Tensor {
+    std::vector<float> data;
+    DataType type;
+    std::vector<size_t> dimensions;
+    Tensor(std::vector<float> x, DataType t, std::vector<size_t> s)
+        : data(std::move(x)), type(t), dimensions(std::move(s)) {
+        for (auto &v : data) v = quantize(v, type);
+    }
+    const Tensor *operator->() const { return this; }
+    const std::vector<size_t> &shape() const { return dimensions; }
+    Tensor as_strided(std::vector<size_t> new_shape, Strides strides) const {
+        if (data.size() != 1 || strides.size() != new_shape.size())
+            throw std::runtime_error("invalid scalar view");
+        for (auto stride : strides) if (stride != 0) throw std::runtime_error("nonzero scalar stride");
+        return Tensor(data, type, new_shape);
+    }
+    DataType dtype() const { return type; }
+    Device device() const { return {}; }
+    static Tensor ones(std::vector<size_t> shape, DataType dtype, Device) {
+        size_t n = 1; for (auto dim : shape) n *= dim;
+        return Tensor(std::vector<float>(n, 1.f), dtype, shape);
+    }
+};
+namespace op {
+Tensor elementwise(const Tensor &a, const Tensor &b, bool multiply) {
+    if (a.shape() != b.shape())
+        throw std::runtime_error("invalid broadcast");
+    auto result = a;
+    for (size_t i = 0; i < a.data.size(); ++i) {
+        const float rhs = b.data[b.data.size() == 1 ? 0 : i];
+        result.data[i] = quantize(multiply ? a.data[i] * rhs : a.data[i] + rhs, a.type);
+    }
+    return result;
+}
+Tensor add(const Tensor &a, const Tensor &b) { return elementwise(a, b, false); }
+Tensor mul(const Tensor &a, const Tensor &b) { return elementwise(a, b, true); }
+}
+}
+'''
+harness += helper + r'''
+int main() {
+    using namespace infinicore;
+    std::mt19937 random(42);
+    std::uniform_real_distribution<float> draw(-4.f, 4.f);
+    size_t checked = 0, mismatches = 0;
+    for (auto dtype : {DataType::BF16, DataType::F32}) {
+        size_t before = mismatches;
+        for (int sample = 0; sample < 2001; ++sample) {
+            std::vector<float> n(6), s(6), t(6);
+            for (int i = 0; i < 6; ++i) {
+                n[i] = draw(random); s[i] = draw(random); t[i] = draw(random);
+            }
+            if (sample == 0) {
+                n = {.75f, 1.f, 2.f, -3.f, .125f, 4.f};
+                s = {1.f / 256, -1.f, -1.f + 1.f / 256, -1.f - 1.f / 128, 0.f, 1.f};
+                t = {0.f, 2.f, 0.f, .25f, -1.f, 0.f};
+            }
+            Tensor norm(n, dtype, {1,2,3}), scale(s, dtype, {1,2,3}), shift(t, dtype, {1,2,3});
+            auto actual = apply_adaln(norm, scale, shift);
+            if (actual.shape() != norm.shape() || actual.dtype() != dtype) return 2;
+            for (int i = 0; i < 6; ++i) {
+                float scale_plus_one = quantize(1.f + scale.data[i], dtype);
+                float modulated = quantize(norm.data[i] * scale_plus_one, dtype);
+                float expected = quantize(modulated + shift.data[i], dtype);
+                ++checked;
+                if (actual.data[i] != expected) {
+                    if (mismatches++ == 0)
+                        std::cout << "first mismatch: actual=" << actual.data[i]
+                                  << " reference=" << expected << '\n';
+                }
+            }
+        }
+        std::cout << (dtype == DataType::BF16 ? "BF16" : "F32")
+                  << " mismatches=" << mismatches - before << '\n';
+    }
+    std::cout << "checked=" << checked << " mismatches=" << mismatches << '\n';
+    return mismatches ? 1 : 0;
+}
+'''
+with tempfile.TemporaryDirectory(prefix='.adaln-cpu-', dir=pathlib.Path(__file__).parent) as folder:
+    folder = pathlib.Path(folder)
+    (folder / 'test.cpp').write_text(harness)
+    subprocess.run(['clang++', '-std=c++17', '-O2', '-ffp-contract=off', str(folder / 'test.cpp'),
+                    '-o', str(folder / 'test')], check=True)
+    sys.exit(subprocess.run([str(folder / 'test')]).returncode)
