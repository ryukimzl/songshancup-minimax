+def _is_binary_extremum(node: ast.Call, operands) -> bool:
+    """Tell the pairwise builtin ``max``/``min`` apart from the reduction form.
+
+    ``max(0.0, x)`` clamps elementwise, while ``max(x, 0)`` reduces along a
+    literal axis.  The reduction form always passes a literal integer axis, or
+    names one with the ``axis``/``dim`` keyword; every other two-operand call
+    that touches a tensor is elementwise.
+    """
+    if len(operands) != 2:
+        return False
+
+    if any(keyword.arg in {"axis", "dim"} for keyword in node.keywords):
+        return False
+
+    if len(node.args) > 1:
+        second = node.args[1]
+
+        if (
+            isinstance(second, ast.Constant)
+            and isinstance(second.value, int)
+            and not isinstance(second.value, bool)
+        ):
+            return False
+
+    return any(getattr(operand.type, "kind", None) == "tensor" for operand in operands)
+
+
 def _axis_from_call(node: ast.Call, *, positional_index: int) -> Any:
     if len(node.args) > positional_index:
         return _literal_value(node.args[positional_index])
