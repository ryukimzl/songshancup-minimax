+def _parse_launch_signature(source_path, kernel_name):
+    """Read the C entry point the CUDA backend generated for one kernel."""
+    source = pathlib.Path(source_path).read_text()
+
+    match = _LAUNCH_SIGNATURE_PATTERN.search(source)
+
+    if match is None:
+        raise ValueError(f"No launch function found in {source_path}.")
+
+    launch_name = match.group(1)
+    parameters = []
+
+    for declaration in match.group(2).split(","):
+        declaration = declaration.strip()
+
+        if not declaration:
+            continue
+
+        type_name, _, name = declaration.rpartition(" ")
+
+        parameters.append((type_name.strip(), name.strip()))
+
+    return launch_name, tuple(parameters)
+
+
+def _write_launch_declaration(output_dir, kernel_name, launch_name, parameters):
+    declaration = ", ".join(f"{type_name} {name}" for type_name, name in parameters)
+    header_path = pathlib.Path(output_dir) / f"{kernel_name}.launch.h"
+    header_path.write_text(
+        f"#ifndef NINETOOTHED_LAUNCH_{kernel_name.upper()}_H\n"
+        f"#define NINETOOTHED_LAUNCH_{kernel_name.upper()}_H\n\n"
+        "#include <cuda_fp16.h>\n"
+        "#include <cuda_bf16.h>\n"
+        "#include <cuda_runtime.h>\n"
+        "#include <stdint.h>\n\n"
+        f'extern "C" int {launch_name}({declaration});\n\n'
+        "#endif\n"
+    )
+
+    return header_path.name
+
+
+def _launch_arguments(parameters, tensor_names):
+    """Translate the generated parameter list into dispatcher expressions.
+
+    The CUDA backend emits tensor pointers followed by each tensor's sizes and
+    strides, with the stream last; ``NineToothedTensor`` carries exactly that
+    information, so the dispatcher can forward it positionally using the
+    application's own parameter names.
+    """
+    arguments = []
+    tensor_index = 0
+
+    for type_name, name in parameters:
+        if "*" in type_name:
+            arguments.append(
+                f"static_cast<{type_name}>({tensor_names[tensor_index]}.data)"
+            )
+            tensor_index += 1
+            continue
+
+        if name == "stream":
+            arguments.append("reinterpret_cast<cudaStream_t>(stream)")
+            continue
+
+        match = _TENSOR_PARAMETER_PATTERN.search(name)
+
+        if match is None:
+            raise ValueError(f"Cannot map launch parameter `{name}` to a tensor.")
+
+        index, kind, axis = match.groups()
+        field = "shape" if kind == "size" else "strides"
+        arguments.append(f"{tensor_names[int(index)]}.{field}[{axis}]")
+
+    return arguments
+
